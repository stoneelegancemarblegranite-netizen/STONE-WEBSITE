# =============================================================================
# Stone Elegance — Apache / Hostinger configuration
#
# Canonical host: https://stonelegance.com  (no www)
# If the real domain is different, change it in the two RewriteRule lines below
# AND in robots.txt, sitemap.xml, the form "redirect" fields and the canonical
# / og:url tags in the home page head.
# =============================================================================

Options -Indexes
AddDefaultCharset UTF-8
ServerSignature Off

DirectoryIndex index.html

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Force HTTPS ----------------------------------------------------------
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://stonelegance.com%{REQUEST_URI} [R=301,L]

  # --- Force non-www --------------------------------------------------------
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://stonelegance.com%{REQUEST_URI} [R=301,L]

  # --- Strip index.html from URLs (one canonical address per page) ----------
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L]

  # --- /thanks and /lp resolve with or without the trailing slash -----------
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# =============================================================================
# Security headers
# =============================================================================
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

  # HSTS — only after HTTPS is confirmed working on the live domain.
  # Comment this out if the certificate is not issued yet.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Never let a proxy cache the form handler.
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

# =============================================================================
# Compression
# =============================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE application/rss+xml image/svg+xml
  AddOutputFilterByType DEFLATE font/woff2 font/ttf application/vnd.ms-fontobject
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# =============================================================================
# Caching — long for assets, short for HTML so copy edits go live immediately
# =============================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"

  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/xml                  "access plus 0 seconds"
  ExpiresByType application/xml           "access plus 0 seconds"
  ExpiresByType application/json          "access plus 0 seconds"

  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"

  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType video/mp4                 "access plus 1 year"

  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType font/ttf                  "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|avif|svg|ico|mp4|woff2|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|json|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# =============================================================================
# MIME types Apache does not always know about
# =============================================================================
<IfModule mod_mime.c>
  AddType image/webp                 .webp
  AddType image/avif                 .avif
  AddType image/svg+xml              .svg
  AddType font/woff2                 .woff2
  AddType application/manifest+json  .webmanifest
  AddType video/mp4                  .mp4
  AddType text/vcard                 .vcf
</IfModule>

# =============================================================================
# Keep working files off the public web
# =============================================================================
<FilesMatch "^\.|\.(md|bak|log|sql|ini|sh|dc\.bak)$">
  Require all denied
</FilesMatch>

# Nothing uploaded by a visitor may ever execute.
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_URI} ^/uploads/.*\.(php|phtml|phar|cgi|pl|py|sh)$ [NC]
  RewriteRule ^ - [F,L]
</IfModule>
